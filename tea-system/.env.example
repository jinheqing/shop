# ============================================================================
# 英国高端定制普洱茶系统 — 完整环境变量模板
# 复制为 .env 并填入实际值，**严禁提交到 git**
# ============================================================================

# ---------- 服务端 ----------
SERVER_ADDR=:8080
SERVER_PORT=8080
GIN_MODE=debug

# ---------- PostgreSQL 业务库 ----------
DB_HOST=postgres
DB_PORT=5432
DB_USER=tea_system
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=tea_system
DB_SSLMODE=disable
DB_BUSINESS_DSN=postgres://tea_system:CHANGE_ME_STRONG_PASSWORD@postgres:5432/tea_system?sslmode=disable

# ---------- PostgreSQL 审计库（独立实例）----------
AUDIT_DB_HOST=postgres_audit
AUDIT_DB_PORT=5432
AUDIT_DB_USER=tea_audit
AUDIT_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUDIT_DB_NAME=tea_audit
DB_AUDIT_DSN=postgres://tea_audit:CHANGE_ME_STRONG_PASSWORD@postgres_audit:5432/tea_audit?sslmode=disable

# ---------- Redis ----------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_USE_64_CHARS_RANDOM_STRING
JWT_STAFF_EXPIRE_MIN=60
JWT_USER_EXPIRE_MIN=120
JWT_REFRESH_EXPIRE_DAY=30

# ---------- LiveKit ----------
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=dev-key
LIVEKIT_API_SECRET=dev-secret
LIVEKIT_WEBHOOK_KEY=

# ---------- MediaMTX ----------
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_WEBRTC_URL=http://localhost:8889

# ---------- WireGuard 内网 ----------
WG_SERVER_PRIVATE_KEY=
WG_SERVER_PUBLIC_KEY=
WG_NETWORK=10.10.0.0/24
WG_GATEWAY_IP=10.10.0.1
WG_PEER_ALLOC_START=10.10.0.10
WG_PUBLIC_IP=YOUR_UK_VPS_PUBLIC_IP

# ---------- FastAPI 翻译引擎 ----------
TRANSLATE_FASTAPI_URL=http://fastapi-translate:8090

# ---------- 邮件（Mailgun EU 节点，GDPR 合规）----------
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=ourdomain.com
MAIL_FROM=noreply@ourdomain.com

# ---------- 支付 ----------
TWOCHECKOUT_SECRET_KEY=
TWOCHECKOUT_SELLER_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # sandbox | live

# ---------- 对象存储 ----------
STORAGE_BASE_URL=https://cdn.ourdomain.com
STORAGE_LOCAL_PATH=/data/storage

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=https://www.ourdomain.com,https://admin.ourdomain.com

# ---------- 日志 ----------
LOG_LEVEL=info
