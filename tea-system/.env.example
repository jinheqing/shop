# ============ 服务器 ============
SERVER_ADDR=:8080
GIN_MODE=debug

# ============ 数据库 ============
DB_HOST=localhost
DB_PORT=5432
DB_USER=tea_system
DB_PASSWORD=changeme
DB_NAME=tea_system
DB_SSLMODE=disable

# 审计日志库（独立 PostgreSQL 实例）
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5432
AUDIT_DB_USER=tea_system
AUDIT_DB_PASSWORD=changeme
AUDIT_DB_NAME=tea_system_audit
AUDIT_DB_SSLMODE=disable

# ============ Redis ============
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ RabbitMQ ============
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ============ JWT ============
JWT_SECRET=please-change-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRE_HOURS=24
REFRESH_SECRET=please-change-to-another-long-random-string-at-least-32-bytes
REFRESH_EXPIRE_HOURS=168

# ============ LiveKit ============
LIVEKIT_URL=wss://live.ourdomain.com
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme

# ============ MediaMTX ============
MEDIAMRTX_RTMP_PORT=1935

# ============ WireGuard（节点管理） ============
WG_SERVER_PRIVATE_KEY=changeme
WG_SERVER_PUBLIC_KEY=changeme
WG_NETWORK=10.10.0.0/24
WG_GATEWAY_IP=10.10.0.1
WG_PEER_ALLOC_START=10.10.0.10
WG_PEER_ALLOC_END=10.10.0.254

# ============ 翻译引擎 ============
TRANSLATE_FASTAPI_URL=http://localhost:8090

# ============ Mailgun ============
MAILGUN_API_KEY=changeme
MAILGUN_DOMAIN=ourdomain.com
MAIL_FROM=noreply@ourdomain.com

# ============ 支付 ============
TWOCHECKOUT_SECRET_KEY=changeme
PAYPAL_CLIENT_ID=changeme
PAYPAL_CLIENT_SECRET=changeme

# ============ 对象存储（英国私有服务器） ============
STORAGE_BASE_URL=https://cdn.ourdomain.com
STORAGE_LOCAL_PATH=/data/storage
