{
  "name": "tea-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend monorepo for tea-system (public site + admin dashboard)",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:public": "pnpm --filter public-site dev",
    "dev:admin": "pnpm --filter admin-dashboard dev",
    "build": "pnpm -r build",
    "build:public": "pnpm --filter public-site build",
    "build:admin": "pnpm --filter admin-dashboard build",
    "lint": "pnpm -r lint"
  }
}
