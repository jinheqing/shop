# ==========================================================================
# 🍵 UK Tea House — 完整环境变量
#   生产部署前务必修改所有默认密码 / 密钥！
# ==========================================================================

# ---------- Docker 镜像仓库 ----------
REGISTRY=ghcr.io
OWNER=jinheqing
IMAGE_TAG=latest

# ---------- 数据库 ----------
DB_USER=tea_system
DB_PASSWORD=changeme_dev
DB_NAME=tea_system
AUDIT_DB_USER=tea_audit
AUDIT_DB_PASSWORD=changeme_audit_dev
AUDIT_DB_NAME=tea_audit

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- RabbitMQ ----------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---------- JWT (生产至少 32 字符随机串) ----------
JWT_SECRET=dev-jwt-secret-change-me-please-64chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- LiveKit SFU ----------
LIVEKIT_API_KEY=dev-key
LIVEKIT_API_SECRET=dev-secret

# ---------- 应用域名 / 品牌 ----------
APP_DOMAIN=https://ukteahouse.co.uk
APP_SERVICE_NAME="UK Tea House"
APP_CONTACT_EMAIL=tea@ukteahouse.co.uk
SERVER_VERSION=1.0.0

# ---------- 默认管理员账号（首次启动自动 seed）----------
ADMIN_SEED_EMAIL=admin@ukteahouse.co.uk
ADMIN_SEED_NAME=Admin
ADMIN_SEED_PASSWORD=Admin!Tea2026

# ---------- 邮件（魔法链接登录、通知）----------
# SMTP 服务器地址（如 smtp.mailgun.org 或 smtp.gmail.com）
SMTP_HOST=
# 发件人地址
MAIL_FROM=tea@ukteahouse.co.uk
# Mailgun API Key（如用 Mailgun）
MAILGUN_API_KEY=

# ---------- 支付 ----------
# 支持 2checkout / paypal / stripe
PAYMENT_GATEWAY=2checkout
PAYMENT_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
